{
  "info": {
    "name": "CodeOrbit - Task 1: Notes REST API",
    "_postman_id": "codeorbit-task1-notes-api",
    "description": "Postman Collection for CodeOrbit Notes REST API running at http://localhost:3001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Root / Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            ""
          ]
        },
        "description": "Verify that the server is responding."
      }
    },
    {
      "name": "1. GET All Notes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/notes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "notes"
          ]
        },
        "description": "Retrieve all notes from local JSON storage."
      }
    },
    {
      "name": "2. POST Create Note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Internship Postman Note\",\n  \"content\": \"Testing Task 1 Notes REST API endpoints.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/notes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "notes"
          ]
        },
        "description": "Create a new note. Stores in data/notes.json."
      }
    },
    {
      "name": "3. GET Note by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/notes/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "notes",
            "1"
          ]
        },
        "description": "Retrieve a single note by its numeric ID."
      }
    },
    {
      "name": "4. PUT Update Note",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Postman Note\",\n  \"content\": \"Updated note body content.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/notes/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "notes",
            "1"
          ]
        },
        "description": "Update an existing note's title and/or content."
      }
    },
    {
      "name": "5. DELETE Note",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/notes/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "notes",
            "1"
          ]
        },
        "description": "Delete an existing note by ID."
      }
    },
    {
      "name": "6. Validation - Empty Title (Expected 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"content\": \"Invalid note without title\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/notes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "notes"
          ]
        },
        "description": "Test rejection of missing/empty title."
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001",
      "type": "string"
    }
  ]
}