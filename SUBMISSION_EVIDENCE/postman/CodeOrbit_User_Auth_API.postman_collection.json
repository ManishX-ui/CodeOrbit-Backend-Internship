{
  "info": {
    "name": "CodeOrbit - Task 2: User Authentication API",
    "_postman_id": "codeorbit-task2-user-auth",
    "description": "Postman Collection for CodeOrbit User Auth API running at http://localhost:3002",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Root / Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            ""
          ]
        }
      }
    },
    {
      "name": "1. POST Signup - Valid Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"johndoe@example.com\",\n  \"password\": \"SecurePassword123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/signup",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "signup"
          ]
        },
        "description": "Registers a user and hashes the password with bcrypt."
      }
    },
    {
      "name": "2. POST Login - Correct Credentials",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"johndoe@example.com\",\n  \"password\": \"SecurePassword123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Authenticates using bcrypt.compare."
      }
    },
    {
      "name": "3. POST Login - Incorrect Password (Expected 401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"johndoe@example.com\",\n  \"password\": \"WrongPassword999!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Verifies rejection of invalid password with 401."
      }
    },
    {
      "name": "4. POST Duplicate Signup (Expected 409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"johndoe@example.com\",\n  \"password\": \"AnotherPassword123!\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/signup",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "signup"
          ]
        },
        "description": "Rejects account creation if email is already taken."
      }
    },
    {
      "name": "5. POST Signup - Missing or Invalid Fields (Expected 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"A\",\n  \"email\": \"bad-email-format\",\n  \"password\": \"short\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/signup",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "signup"
          ]
        },
        "description": "Validates minimum length for name, regex for email, and minimum length for password."
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
